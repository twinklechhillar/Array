class Main {
    public static void main(String[] args) {
        int[] arr = {23,56,78,90};
        int smallest= arr[0];
        for(int i=0; i<arr.length; i++){
            if(arr[i]<smallest){
                smallest = arr[i];
            }
        }
        System.out.println(smallest+ " ");
    }
}
