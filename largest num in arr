
class Main {
    public static void main(String[] args) {
        int[]arr = {7,9,14,45,67,89,99};
        int largest = arr[0];
        
        for(int i=0; i<arr.length; i++){
            if(arr[i]>largest){
                largest= arr[i];
            }
        }
        System.out.println(largest + " " );
    }
}
