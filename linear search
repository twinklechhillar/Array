import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[]arr= new int[n];
        
        for(int i=0; i<n; i++){
            arr[i]=sc.nextInt();
        }
        int target = sc.nextInt();
        boolean found = false;
        for(int i=0; i<n; i++){
            if(arr[i]==target){
                found=true;
            }
        }
        if(found){
            System.out.println("found");
        } else{
           System.out.println("not found"); 
        }
        
    }
}
